# Copy to .env and set values locally. Never commit a real token.

# ---- Production / developer UI -------------------------------------------
# "/" is the production investigation dashboard. The developer console (raw
# JSON, model ids and hashes, decode/FPS panels, detector and OCR diagnostics,
# threshold controls, worker manager, capacity estimator) is served at /dev and
# is OFF by default. Nothing is deleted when it is off -- the routes simply
# return 404 and the console files are never served from the public /static
# mount.
#
# Both variables must change together: /dev stays unreachable while APP_ENV is
# production, even if ENABLE_DEVELOPER_UI is true. For a developer machine:
#   APP_ENV=development
#   ENABLE_DEVELOPER_UI=true
APP_ENV=production
ENABLE_DEVELOPER_UI=false

# ---- Operator access token -----------------------------------------------
# What an investigator types into the console's sign-in screen, and what every
# write, export and evidence request must carry as `Authorization: Bearer ...`.
# The default below is a SHARED DEMO VALUE, not a secret -- change it before
# this runs anywhere real, then restart (it is read once at startup).
#
# The browser holds it in sessionStorage for one tab and sends it only as a
# header. It is never embedded in the served JavaScript.
#
# EVERY route requires this token except the sign-in page itself, /healthz and
# /api/ui/config. Read endpoints used to be open; they are not any more.
ADMIN_TOKEN=p0-operator
# Separate credential, used only by POST /api/vendor/events.
VENDOR_INGEST_TOKEN=p0-vendor
# REQUIRE_AUTH was removed. It made a request carrying NO token succeed, which
# turned every operator route anonymous from one variable. A line setting it is
# now ignored.

INGEST_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
CCTV_AUTH_MODE=none
# CCTV_AUTH_MODE=bearer|basic|custom_header|form
# Form login on cctv.corp8.cloud needs email + access password.
# The same pair is inserted into RTSP/WHEP at open time (email @ → %40):
#   rtsp://you%40example.com:PASSWORD@103.250.160.189:8554/stream/<id>
# HLS stays https://cctv.corp8.cloud/<id>/index.m3u8 with the portal session cookie.
# Credentials are not stored on camera rows. RTSP is forced TCP. No seeking.
# CCTV_ACCESS_USERNAME=you@example.com
# CCTV_ACCESS_TOKEN=
# CCTV_AUTH_HEADER_NAME=
# CCTV_LOGIN_URL=https://cctv.corp8.cloud/auth/login
RTSP_TRANSPORT=tcp
RTSP_RECONNECT_INITIAL_SECONDS=2
RTSP_RECONNECT_MAX_SECONDS=30
# Concurrent live camera workers. Was 4 because SQLite's whole-file write lock
# could not survive more (34 "database is locked" failures in the recorded run);
# with PostgreSQL the limit is host decode capacity instead. Measured on the
# RTX A4500 host: 30 workers start, ~16-23 cameras decode concurrently.
MAX_CONCURRENT_WORKERS=32
MAX_CONCURRENT_CAPTURES=32

# --- Database -------------------------------------------------------------
# PostgreSQL is required for many concurrent cameras. One-time setup:
#   conda create -n pgsrv -c conda-forge -y postgresql
#   python scripts/setup_postgres.py --start
#   python scripts/migrate_to_postgres.py --target '<url printed above>'
# Day to day:  scripts/postgres_ctl.sh start|stop|status
# DATABASE_URL=postgresql+psycopg://cctv@127.0.0.1:5432/cctv
#
# Leave DATABASE_URL unset to use the SQLite fallback. That path now enables WAL
# and a busy timeout so it no longer deadlocks, but PostgreSQL degrades far more
# gracefully under load and is what the camera fleet should run on.
# Pool sizing is automatic (worker count + headroom); override only if needed:
# DB_POOL_SIZE=0
# DB_MAX_OVERFLOW=0
# Local Ollama (no key). qwen3-vl:8b fits a 20 GB GPU with room for YOLOv8n.
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_API_KEY=
OLLAMA_VISION_MODEL=qwen3-vl:8b
# Ollama Cloud (no local server; API key required):
# OLLAMA_URL=https://ollama.com
# OLLAMA_API_KEY=
# OLLAMA_VISION_MODEL=gemma4:31b
# A VLM must never infer vehicle type, colour or plate text. Keep this false.
OLLAMA_VISION_ENABLED=false
OLLAMA_VISION_ON_OWN_FEED=true
YOLO_ENABLED=true
YOLO_WEIGHTS=yolov8n.pt
YOLO_DEVICE=auto
YOLO_CONF=0.25
YOLO_MAX_CROPS=2
# Vehicle-first investigation records up to this many detected vehicles per sampled frame.
VEHICLE_MAX_DETECTIONS=8
# Retired: vehicle attributes used to come from an Ollama VLM here.
VEHICLE_ATTRIBUTE_REFINEMENT_ENABLED=false
VEHICLE_ATTRIBUTE_MODEL=qwen3-vl:8b
VEHICLE_ATTRIBUTE_QUEUE_SIZE=16
VEHICLE_ATTRIBUTE_MAX_AGE_SECONDS=20
VEHICLE_ATTRIBUTE_MIN_CONFIDENCE=0.65
# Snap-to-road: public OSRM Match by default (no key, no credit card).
MAP_MATCH_PROVIDER=osrm
OSRM_MATCH_URL=http://router.project-osrm.org
MAP_MATCH_RADIUS_M=25
# Optional hosted matching (not required for the demo):
# MAPBOX_ACCESS_TOKEN= 
# GEOAPIFY_API_KEY=
DEMO_AUTOSTART_WORKERS=true
DEMO_DECODE_OK_ONLY=true
# Hunt rotates 4 capture slots across all live catalogue cameras.
HUNT_DWELL_SECONDS=28
HUNT_MAX_FRAMES=40
OLLAMA_LIVE_INTERVAL_SECONDS=0.4
CLOUD_VERIFIER_QUEUE_ENABLED=true
CLOUD_VERIFIER_QUEUE_SIZE=8
CLOUD_VERIFIER_MAX_AGE_SECONDS=12
# Deterministic local OpenCV preprocessing; disable to compare against raw inputs.
VISION_ENHANCEMENT_ENABLED=true
VISION_ONLY_ENABLED=false
VISION_ONLY_INTERVAL_SECONDS=8
# Local default is qwen3-vl:8b. Cloud can use gemma4:31b,glm-5.3-flash.
VISION_ONLY_MODELS=qwen3-vl:8b
# CPU-only dedicated plate detector/OCR. Install requirements-cpu-anpr.txt and
# run scripts/setup_cpu_anpr.py before changing MODELS_READY to true.
CPU_ANPR_ENABLED=true
# ANPR starts off until an operator enables it in the Plate Tools panel.
PLATE_RECOGNITION_ENABLED=false
CPU_ANPR_MODELS_READY=false
CPU_ANPR_TESSERACT_ENABLED=true
# Linux conda: TESSERACT_CMD=$CONDA_PREFIX/bin/tesseract
# Windows:     TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
CPU_ANPR_SECONDARY_TESSERACT=true
CPU_ANPR_SECONDARY_TRIGGER_CONFIDENCE=0.98
CPU_ANPR_DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end
CPU_ANPR_OCR_MODEL=cct-s-v2-global-model
CPU_ANPR_WORKERS=1
CPU_ANPR_MIN_PLATE_WIDTH_PX=48
CPU_ANPR_MIN_PLATE_HEIGHT_PX=14
CPU_ANPR_MIN_DETECTOR_CONFIDENCE=0.35
PLATE_CONFIRMATION_MIN_FRAMES=2
PLATE_CONFIRMATION_MIN_GAP_MS=100
PLATE_CONFIRMATION_MEDIAN_CONFIDENCE=0.75
PLATE_CONFIRMATION_MIN_CHAR_CONFIDENCE=0.55
ACTIVE_TRACK_FPS_MULTIPLIER=2
ACTIVE_TRACK_MAX_FPS=6
ACTIVE_TRACK_HOLD_SECONDS=1.5

# ---- Deterministic vehicle attributes (OpenVINO OMZ) ----------------------
# Model: vehicle-attributes-recognition-barrier-0042, Apache-2.0.
# Download with: python scripts/pull_vehicle_attributes.py
#
# Genuinely supported outputs -- everything else abstains to "unknown":
#   types   car, van, truck, bus      (+ two_wheeler from COCO id 3)
#   colours white, gray, yellow, red, green, blue, black
# NOT supported by any weight on this host: suv, auto_rickshaw, taxi_cab,
# silver, brown, orange, other.  gray is never rewritten to silver.
VATTR_ENABLED=true
VATTR_WEIGHTS=data/models/vehicle-attributes-recognition-barrier-0042/FP16
VATTR_DEVICE=CPU
VATTR_EXTEND=0.30

# Abstention gate. These are conservative starting values derived from the
# vendor's per-class accuracies; NONE are calibrated on Indian CCTV.
VATTR_BEST_CROPS_PER_TRACK=3
VATTR_MIN_OBSERVATIONS=2
VATTR_TYPE_MIN_PROB=0.60
VATTR_TYPE_MIN_MARGIN=0.15
VATTR_TYPE_MIN_AGREEMENT=0.60
VATTR_COLOR_MIN_PROB=0.55
VATTR_COLOR_MIN_MARGIN=0.12
VATTR_COLOR_MIN_AGREEMENT=0.60
VATTR_TWO_WHEELER_COLOR_ENABLED=false

# Detector/classifier conflict on bus/truck. detector | abstain | classifier
# Measured on 20 labelled cam01 tracks: detector 90% coverage / 50% precision,
# abstain 55% / 36%, classifier 85% / 29%. detector wins on both axes.
# 50% is still NOT usable -- vehicle type needs fine-tuning. See README.
VATTR_CONFLICT_POLICY=detector
VATTR_TYPE_CONFLICT_MIN_PROB=0.75

# Crop-quality gate.
VATTR_MIN_CROP_PX=40
VATTR_MIN_SHARPNESS=25.0
VATTR_MIN_VISIBLE_FRACTION=0.70
VATTR_MAX_DARK_FRACTION=0.60
VATTR_MAX_CLIPPED_FRACTION=0.35
VATTR_MIN_DETECTOR_CONFIDENCE=0.30

# Tracking. ByteTrack needs `lap`; without it a weaker greedy-IoU fallback
# runs and says so in tracker_source.
VATTR_TRACKER=bytetrack.yaml
VATTR_FORCE_IOU_TRACKER=false
VATTR_TRACK_TIMEOUT_SECONDS=3.0

# ANPR stays optional and can never gate a vehicle observation.
VATTR_ANPR_ENABLED=false

# ---- Multi-vehicle crop rejection ----------------------------------------
# Reject a crop when this much of it belongs to a DIFFERENT vehicle. Measured
# on cam01: 20% of crops held >25% of a neighbour, which corrupted vehicle type.
VATTR_MAX_FOREIGN_FRACTION=0.25

# ---- Camera slot rotation ------------------------------------------------
# least_recent | random | fixed. `fixed` is the legacy behaviour that pinned
# cam01-cam05 on every click and never reached the rest of the catalogue.
HUNT_ROTATION=least_recent
# Share of slots reserved for UNTESTED cameras, so they stop starving.
HUNT_EXPLORE_FRACTION=0.5
HUNT_PIN_SEED=0
