# Copy to .env and set values locally. Never commit a real token.
INGEST_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
CCTV_AUTH_MODE=none
# CCTV_AUTH_MODE=bearer|basic|custom_header|form
# Form login on cctv.corp8.cloud needs email + access password.
# The same pair is inserted into RTSP/WHEP at open time (email @ → %40):
#   rtsp://you%40example.com:PASSWORD@103.250.160.189:8554/stream/<id>
# HLS stays https://cctv.corp8.cloud/<id>/index.m3u8 with the portal session cookie.
# Credentials are not stored on camera rows. RTSP is forced TCP. No seeking.
# CCTV_ACCESS_USERNAME=you@example.com
# CCTV_ACCESS_TOKEN=
# CCTV_AUTH_HEADER_NAME=
# CCTV_LOGIN_URL=https://cctv.corp8.cloud/auth/login
RTSP_TRANSPORT=tcp
RTSP_RECONNECT_INITIAL_SECONDS=2
RTSP_RECONNECT_MAX_SECONDS=30
MAX_CONCURRENT_CAPTURES=4
# Local Ollama (no key):
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_VISION_MODEL=llava:7b
# Ollama Cloud (no local server; API key required):
OLLAMA_URL=https://ollama.com
# OLLAMA_API_KEY=
OLLAMA_VISION_MODEL=gemma4:31b
OLLAMA_VISION_ENABLED=true
OLLAMA_VISION_ON_OWN_FEED=true
YOLO_ENABLED=true
YOLO_WEIGHTS=yolov8n.pt
YOLO_DEVICE=auto
YOLO_CONF=0.25
YOLO_MAX_CROPS=2
# Vehicle-first investigation records up to this many detected vehicles per sampled frame.
VEHICLE_MAX_DETECTIONS=8
VEHICLE_ATTRIBUTE_REFINEMENT_ENABLED=true
VEHICLE_ATTRIBUTE_MODEL=gemma4:31b
VEHICLE_ATTRIBUTE_QUEUE_SIZE=16
VEHICLE_ATTRIBUTE_MAX_AGE_SECONDS=20
VEHICLE_ATTRIBUTE_MIN_CONFIDENCE=0.65
# Snap-to-road: public OSRM Match by default (no key, no credit card).
MAP_MATCH_PROVIDER=osrm
OSRM_MATCH_URL=http://router.project-osrm.org
MAP_MATCH_RADIUS_M=25
# Optional hosted matching (not required for the demo):
# MAPBOX_ACCESS_TOKEN= 
# GEOAPIFY_API_KEY=
DEMO_AUTOSTART_WORKERS=true
DEMO_DECODE_OK_ONLY=true
# Hunt rotates 4 capture slots across all live catalogue cameras.
HUNT_DWELL_SECONDS=28
HUNT_MAX_FRAMES=40
OLLAMA_LIVE_INTERVAL_SECONDS=0.4
CLOUD_VERIFIER_QUEUE_ENABLED=true
CLOUD_VERIFIER_QUEUE_SIZE=8
CLOUD_VERIFIER_MAX_AGE_SECONDS=12
# Deterministic local OpenCV preprocessing; disable to compare against raw inputs.
VISION_ENHANCEMENT_ENABLED=true
VISION_ONLY_ENABLED=false
VISION_ONLY_INTERVAL_SECONDS=8
# Gemma then GLM 5.3 Flash on Ollama Cloud. qwen2.5vl is not available there.
VISION_ONLY_MODELS=gemma4:31b,glm-5.3-flash
# CPU-only dedicated plate detector/OCR. Install requirements-cpu-anpr.txt and
# run scripts/setup_cpu_anpr.py before changing MODELS_READY to true.
CPU_ANPR_ENABLED=true
# ANPR starts off until an operator enables it in the Plate Tools panel.
PLATE_RECOGNITION_ENABLED=false
CPU_ANPR_MODELS_READY=false
CPU_ANPR_TESSERACT_ENABLED=true
CPU_ANPR_SECONDARY_TESSERACT=true
CPU_ANPR_SECONDARY_TRIGGER_CONFIDENCE=0.98
CPU_ANPR_DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end
CPU_ANPR_OCR_MODEL=cct-s-v2-global-model
CPU_ANPR_WORKERS=1
CPU_ANPR_MIN_PLATE_WIDTH_PX=48
CPU_ANPR_MIN_PLATE_HEIGHT_PX=14
CPU_ANPR_MIN_DETECTOR_CONFIDENCE=0.35
PLATE_CONFIRMATION_MIN_FRAMES=2
PLATE_CONFIRMATION_MIN_GAP_MS=100
PLATE_CONFIRMATION_MEDIAN_CONFIDENCE=0.75
PLATE_CONFIRMATION_MIN_CHAR_CONFIDENCE=0.55
ACTIVE_TRACK_FPS_MULTIPLIER=2
ACTIVE_TRACK_MAX_FPS=6
ACTIVE_TRACK_HOLD_SECONDS=1.5
